{
  "name": "pocketvault",
  "version": "0.1.0",
  "description": "PocketVault - offline-first personal finance tracker (Electron + React + SQLite)",
  "author": "PocketVault",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "icons": "node scripts/generate-icon.mjs",
    "test": "node scripts/run-tests.mjs",
    "postinstall": "electron-builder install-app-deps && node node_modules/electron/install.js",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml --config.directories.output=installers/windows",
    "build:mac": "npm run build && electron-builder --mac --config electron-builder.yml --config.directories.output=installers/macos",
    "build:linux": "npm run build && electron-builder --linux --config electron-builder.yml --config.directories.output=installers/linux"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
